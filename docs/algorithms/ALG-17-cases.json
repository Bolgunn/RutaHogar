{
  "algorithm": "ALG-17",
  "version": "1.0.0",
  "cases": [
    {
      "name": "pending invitation keeps a referential declared complement",
      "input": { "invitation_status": "pending", "consent": false, "now_before_expiry": true },
      "expect": { "complement_source": "lead_declared", "confirmation_status": "not_confirmed", "rescore_required": false }
    },
    {
      "name": "expired invitation keeps declared data but labels it unconfirmed",
      "input": { "invitation_status": "pending", "consent": false, "now_before_expiry": false },
      "expect": { "invitation_status": "expired", "complement_source": "lead_declared", "confirmation_status": "not_confirmed", "rescore_required": false }
    },
    {
      "name": "valid consented submission overrides lead declaration and rescoring is immediate",
      "input": { "invitation_status": "pending", "token_valid": true, "phone_verified": true, "treatment_consent": true, "submitted_values": "different" },
      "expect": { "invitation_status": "confirmed", "complement_source": "co_debtor_confirmed", "confirmation_status": "confirmed", "rescore_required": true, "rescore_reason": "confirmacion_codeudor" }
    },
    {
      "name": "a declined submission stores no financial rejection detail",
      "input": { "invitation_status": "pending", "token_valid": true, "co_debtor_action": "decline" },
      "expect": { "complement_source": "lead_declared", "confirmation_status": "not_confirmed", "financial_rejection_detail_stored": false }
    },
    {
      "name": "revocation excludes complement only from future evaluations",
      "input": { "invitation_status": "confirmed", "revoked": true },
      "expect": { "invitation_status": "revoked", "future_complement_source": "excluded_after_revocation", "rescore_required": false, "historical_snapshots_preserved": true, "staff_raw_values_visible": false }
    },
    {
      "name": "a replacement invitation invalidates the active token",
      "input": { "active_invitation": true, "replacement_invitation_created": true },
      "expect": { "previous_invitation_valid": false, "active_invitation_count": 1 }
    }
  ]
}
