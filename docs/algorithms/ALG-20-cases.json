{
  "algorithm": "ALG-20",
  "version": "hu26-project-interest-v2",
  "nota": "Shorthand. `proyectos` is a list of ids; each expands to { id, nombre: id, comuna: 'Ñuñoa', tipo: 'departamento', precio_min_uf: 3000, precio_max_uf: 4000, estado: 'en_venta' }, in that order. A lead's `interacciones` entries default to visualizaciones 0, favorito false, simulaciones 0 (and en_alcance true when absent). `sin_evaluacion: true` makes evaluacion_actual null; otherwise it is an opaque object and `alg10` maps a proyecto_id to the ALG-10 verdict the fake match returns for that pair: `motivo_exclusion` null means a match (with `clasificacion`, default 'Compatible', and `alcanza_precio_min`, default true), anything else an excluded row; `codigo` is bloqueador_principal.codigo (null = no bloqueador_principal). The fake match fails the test if it is called with a project the lead is not interested in, or for a lead without an evaluation. `expect` is a deep-partial match; `ranking` lists rows in the expected order (every row, so its length is asserted).",
  "cases": [
    {
      "name": "ranking_por_interesados_no_por_volumen",
      "why": "R2 key 1. One lead opening P1 on ten days is less demand than two leads opening P2 once.",
      "proyectos": ["P1", "P2"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 10 }], "alg10": { "P1": { "motivo_exclusion": null } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P2", "visualizaciones": 1 }], "alg10": { "P2": { "motivo_exclusion": null } } },
        { "lead_id": "3", "interacciones": [{ "proyecto_id": "P2", "visualizaciones": 1 }], "alg10": { "P2": { "motivo_exclusion": null } } }
      ],
      "expect": {
        "n_leads": 3,
        "totales": { "visualizaciones": 12, "favoritos": 0, "simulaciones": 0 },
        "ranking": [
          { "proyecto_id": "P2", "posicion": 1, "interesados": 2, "visualizaciones": 2 },
          { "proyecto_id": "P1", "posicion": 2, "interesados": 1, "visualizaciones": 10 }
        ]
      }
    },
    {
      "name": "desempate_favoritos_simulaciones_visualizaciones_orden_de_entrada",
      "why": "R2 keys 2-5. Equal interesados: favorite beats saved simulation beats views; P4 and P1 tie on every count and keep the input order (P4 is listed first).",
      "proyectos": ["P4", "P1", "P2", "P3"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 5 }], "alg10": { "P1": { "motivo_exclusion": null } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P2", "favorito": true }], "alg10": { "P2": { "motivo_exclusion": null } } },
        { "lead_id": "3", "interacciones": [{ "proyecto_id": "P3", "simulaciones": 1 }], "alg10": { "P3": { "motivo_exclusion": null } } },
        { "lead_id": "4", "interacciones": [{ "proyecto_id": "P4", "visualizaciones": 5 }], "alg10": { "P4": { "motivo_exclusion": null } } }
      ],
      "expect": {
        "ranking": [
          { "proyecto_id": "P2", "favoritos": 1 },
          { "proyecto_id": "P3", "simulaciones": 1 },
          { "proyecto_id": "P4", "visualizaciones": 5 },
          { "proyecto_id": "P1", "visualizaciones": 5 }
        ]
      }
    },
    {
      "name": "proyecto_sin_interes_aparece_al_final",
      "why": "R2: every project appears; one nobody looked at is the finding. Its rate is null, never 0 (R3).",
      "proyectos": ["P1", "P2"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P2", "visualizaciones": 1, "favorito": true, "simulaciones": 2 }], "alg10": { "P2": { "motivo_exclusion": null } } }
      ],
      "expect": {
        "n_leads": 1,
        "totales": { "visualizaciones": 1, "favoritos": 1, "simulaciones": 2 },
        "ranking": [
          { "proyecto_id": "P2", "posicion": 1, "interesados": 1, "visualizaciones": 1, "favoritos": 1, "simulaciones": 2 },
          {
            "proyecto_id": "P1", "posicion": 2, "interesados": 0, "visualizaciones": 0, "favoritos": 0, "simulaciones": 0,
            "compatibilidad": { "compatibles": 0, "incompatibles": 0, "sin_datos": 0, "evaluables": 0, "tasa_incompatibles": null },
            "motivos": []
          }
        ]
      }
    },
    {
      "name": "entrada_vacia_no_es_interes",
      "why": "R1: an entry with no view, no favorite and no simulation does not make the lead interesado, and match is never asked about it.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1" }], "alg10": {} }
      ],
      "expect": {
        "n_leads": 0,
        "ranking": [{ "proyecto_id": "P1", "interesados": 0 }]
      }
    },
    {
      "name": "lead_en_dos_proyectos_cuenta_una_vez",
      "why": "R1: a lead interested in two projects is in both rows and once in n_leads. R3: the verdict is per pair.",
      "proyectos": ["P1", "P2"],
      "leads": [
        {
          "lead_id": "1",
          "interacciones": [{ "proyecto_id": "P1", "favorito": true }, { "proyecto_id": "P2", "visualizaciones": 1 }],
          "alg10": { "P1": { "motivo_exclusion": null }, "P2": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "pie_insuficiente_para_proyecto" } }
        }
      ],
      "expect": {
        "n_leads": 1,
        "ranking": [
          { "proyecto_id": "P1", "interesados": 1, "compatibilidad": { "compatibles": 1, "incompatibles": 0, "tasa_incompatibles": 0 }, "motivos": [] },
          { "proyecto_id": "P2", "interesados": 1, "compatibilidad": { "compatibles": 0, "incompatibles": 1, "tasa_incompatibles": 1 }, "motivos": [{ "motivo": "pie_insuficiente_para_proyecto", "n": 1, "proporcion": 1 }] }
        ]
      }
    },
    {
      "name": "buckets_de_compatibilidad",
      "why": "R3 C1-C4. A near-miss match is compatible (A8); G0 and a missing evaluation are sin_datos and stay out of the rate's denominator.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": null, "clasificacion": "Compatible" } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": null, "clasificacion": "Cercano", "alcanza_precio_min": false } } },
        { "lead_id": "3", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "bloqueador_critico", "codigo": "morosidad_vigente" } } },
        { "lead_id": "4", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "pie_insuficiente_para_proyecto" } } },
        { "lead_id": "5", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_requiere_antecedentes", "codigo": null } } },
        { "lead_id": "6", "sin_evaluacion": true, "interacciones": [{ "proyecto_id": "P1", "favorito": true }] }
      ],
      "expect": {
        "ranking": [
          {
            "proyecto_id": "P1", "interesados": 6,
            "compatibilidad": { "compatibles": 2, "incompatibles": 2, "sin_datos": 2, "evaluables": 4, "tasa_incompatibles": 0.5 }
          }
        ]
      }
    },
    {
      "name": "motivos_agrupados_y_ordenados",
      "why": "R4 M1 and M3; grouping sorted by n descending, then motivo ascending.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "renta_insuficiente_para_proyecto" } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "renta_insuficiente_para_proyecto" } } },
        { "lead_id": "3", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "pie_insuficiente_para_proyecto" } } },
        { "lead_id": "4", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "bloqueador_critico", "codigo": "morosidad_vigente" } } },
        { "lead_id": "5", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "bloqueador_critico", "codigo": "carga_total_alta" } } },
        { "lead_id": "6", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": null } } }
      ],
      "expect": {
        "ranking": [
          {
            "proyecto_id": "P1",
            "compatibilidad": { "compatibles": 1, "incompatibles": 5, "sin_datos": 0, "evaluables": 6 },
            "motivos": [
              { "motivo": "renta_insuficiente_para_proyecto", "n": 2, "proporcion": 0.4 },
              { "motivo": "carga_total_alta", "n": 1, "proporcion": 0.2 },
              { "motivo": "morosidad_vigente", "n": 1, "proporcion": 0.2 },
              { "motivo": "pie_insuficiente_para_proyecto", "n": 1, "proporcion": 0.2 }
            ]
          }
        ]
      }
    },
    {
      "name": "motivo_de_capacidad_no_toma_un_bloqueador_no_critico",
      "why": "R4 M2 and M4. A pair excluded by capacity whose bloqueador_principal is a non-critical blocker (ALG-10 R3 step 4) or absent reports capacidad_insuficiente; a critical exclusion without a code reports bloqueador_critico.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": "edad_plazo_riesgoso" } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_insuficiente", "codigo": null } } },
        { "lead_id": "3", "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "bloqueador_critico", "codigo": null } } }
      ],
      "expect": {
        "ranking": [
          {
            "proyecto_id": "P1",
            "motivos": [
              { "motivo": "capacidad_insuficiente", "n": 2 },
              { "motivo": "bloqueador_critico", "n": 1 }
            ]
          }
        ]
      }
    },
    {
      "name": "solo_sin_datos_tasa_nula",
      "why": "R3: when no interested lead is evaluable the rate is null, never 0, and there are no motivos.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "sin_evaluacion": true, "interacciones": [{ "proyecto_id": "P1", "visualizaciones": 2 }] },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P1", "simulaciones": 1 }], "alg10": { "P1": { "motivo_exclusion": "capacidad_requiere_antecedentes", "codigo": null } } }
      ],
      "expect": {
        "ranking": [
          {
            "proyecto_id": "P1", "interesados": 2,
            "compatibilidad": { "compatibles": 0, "incompatibles": 0, "sin_datos": 2, "evaluables": 0, "tasa_incompatibles": null },
            "motivos": []
          }
        ]
      }
    },
    {
      "name": "interaccion_fuera_del_catalogo_se_ignora",
      "why": "R1: an entry for a project not in `proyectos` counts nowhere.",
      "proyectos": ["P1"],
      "leads": [
        { "lead_id": "1", "interacciones": [{ "proyecto_id": "PX", "visualizaciones": 3, "favorito": true }], "alg10": {} }
      ],
      "expect": {
        "n_leads": 0,
        "totales": { "visualizaciones": 0, "favoritos": 0, "simulaciones": 0 },
        "ranking": [{ "proyecto_id": "P1", "interesados": 0 }]
      }
    },
    {
      "name": "fuera_de_alcance_cuenta_como_interes_sin_datos",
      "why": "R3 C0: an interaction outside lead_belongs_to_proyecto (en_alcance false) counts as interest, but the lead's evaluation is never compared with that project: the pair goes to sin_datos.",
      "proyectos": ["P1", "P2"],
      "leads": [
        { "lead_id": "1", "interacciones": [
            { "proyecto_id": "P1", "favorito": true },
            { "proyecto_id": "P2", "en_alcance": false, "simulaciones": 2 }
          ],
          "alg10": { "P1": { "motivo_exclusion": "bloqueador_critico", "codigo": "morosidad_vigente" } } },
        { "lead_id": "2", "interacciones": [{ "proyecto_id": "P2", "en_alcance": false, "visualizaciones": 1 }], "alg10": {} }
      ],
      "expect": {
        "n_leads": 2,
        "ranking": [
          {
            "proyecto_id": "P2", "interesados": 2, "simulaciones": 2, "visualizaciones": 1,
            "compatibilidad": { "compatibles": 0, "incompatibles": 0, "sin_datos": 2, "evaluables": 0, "tasa_incompatibles": null },
            "motivos": []
          },
          {
            "proyecto_id": "P1", "interesados": 1, "favoritos": 1,
            "compatibilidad": { "compatibles": 0, "incompatibles": 1, "sin_datos": 0 },
            "motivos": [{ "motivo": "morosidad_vigente", "n": 1 }]
          }
        ]
      }
    },
    {
      "name": "sin_proyectos",
      "why": "Edge case: an inmobiliaria without projects gets an empty ranking, not an error.",
      "proyectos": [],
      "leads": [],
      "expect": {
        "n_leads": 0,
        "totales": { "visualizaciones": 0, "favoritos": 0, "simulaciones": 0 },
        "ranking": []
      }
    }
  ]
}
