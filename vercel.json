{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/score",
      "destination": "/api/score"
    },
    {
      "source": "/score/(.*)",
      "destination": "/api/score"
    },
    {
      "source": "/market-reference",
      "destination": "/api/score"
    },
    {
      "source": "/interest",
      "destination": "/api/score"
    },
    {
      "source": "/academy/(.*)",
      "destination": "/api/score"
    },
    {
      "source": "/tracking",
      "destination": "/api/score"
    },
    {
      "source": "/tracking/(.*)",
      "destination": "/api/score"
    },
    {
      "source": "/api/v1/crm-mock/(.*)",
      "destination": "/api/score"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
