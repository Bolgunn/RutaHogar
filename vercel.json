{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/lead-changes/daily-digest",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    { "source": "/score", "destination": "/api/score" },
    { "source": "/tracking", "destination": "/api/score" },
    { "source": "/tracking/(.*)", "destination": "/api/score" },
    { "source": "/lead-changes/(.*)", "destination": "/api/score" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
