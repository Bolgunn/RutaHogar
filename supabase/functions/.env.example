# Variables de las Edge Functions.
# Copia este archivo a .env.local para pruebas locales:
#   cp supabase/functions/.env.example supabase/functions/.env.local
#   supabase functions serve <funcion> --env-file supabase/functions/.env.local
#
# IMPORTANTE: en produccion este archivo NO se usa. Las funciones desplegadas
# leen los secrets del proyecto: supabase secrets set NOMBRE=valor

# Compartido por submit-feedback, create-executive y notify-admin-arco.
RESEND_API_KEY=

# submit-feedback
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=ScoreLeads <onboarding@resend.dev>

# create-executive
# Remitente del correo con el enlace para definir contrasena. El valor por
# defecto (onboarding@resend.dev) es el sandbox de Resend y SOLO entrega al
# correo de la cuenta Resend: para enviar a ejecutivos reales hay que verificar
# un dominio propio y ponerlo aqui.
EJECUTIVO_FROM_EMAIL=ScoreLeads <onboarding@resend.dev>
# Base del enlace de recuperacion (redirige a /definir-password).
# Local: http://localhost:5173 · Produccion: la URL del front desplegado.
APP_URL=http://localhost:5173

# notify-admin-arco
# Destinatario obligatorio de las notificaciones de solicitudes ARCO (datos
# personales). La función no envía correos si esta variable no está definida.
ARCO_NOTIFICATION_EMAIL=
# Remitente de las notificaciones ARCO. Debe ser un remitente autorizado en
# Resend fuera del entorno sandbox.
ARCO_FROM_EMAIL=RutaHogar <onboarding@resend.dev>
